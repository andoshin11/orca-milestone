{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "milestone",
  "publisher": "andoshin11",
  "name": "Milestone",
  "version": "0.2.0",
  "description": "Shows the tasks Claude Code is working through in the focused workspace as milestones in the right sidebar.",
  "author": { "name": "andoshin11", "url": "https://github.com/andoshin11" },
  "repository": "https://github.com/andoshin11/orca-milestone",
  "license": "MIT",
  "engines": { "orca": ">=1.4.245" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [{ "id": "milestones", "title": "Milestones", "icon": "flag", "entry": "panel/index.html" }],
    "commands": [{ "id": "milestone.refresh", "title": "Milestone: Refresh" }],
    "events": [{ "on": "agent.status.changed" }]
  },
  "capabilities": [{ "kind": "workspace:read" }, { "kind": "agent:read" }]
}
