{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "milestone",
  "publisher": "andoshin11",
  "name": "Milestone",
  "version": "0.10.0",
  "description": "Shows the tasks Claude Code and Codex are working through in the focused workspace as milestones in the right sidebar.",
  "author": { "name": "andoshin11", "url": "https://github.com/andoshin11" },
  "repository": "https://github.com/andoshin11/orca-milestone",
  "license": "MIT",
  "engines": { "orca": ">=1.4.248" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [{ "id": "milestones", "title": "Milestones", "icon": "flag", "entry": "panel/index.html" }],
    "commands": [{ "id": "milestone.refresh", "title": "Milestone: Refresh" }],
    "events": [{ "on": "agent.status.changed" }, { "on": "workspace.changed" }],
    "hooks": [{ "event": "agent.launch.before" }],
    "settings": [
      {
        "key": "remoteUrl",
        "title": "Remote agent-status-panel",
        "description": "Host name or https URL of the agent-status-panel daemon on another Mac, served by tailscale serve, such as mac-mini.example.ts.net. Its sessions show below the other workspaces, and their buttons press there. Leave empty to show only this Mac.",
        "type": "string",
        "default": "",
        "maxLength": 512,
        "placeholder": "mac-mini.example.ts.net"
      },
      {
        "key": "remoteLabel",
        "title": "Remote name",
        "description": "Heading of the remote sessions in the panel.",
        "type": "string",
        "default": "Mac mini",
        "maxLength": 64
      }
    ]
  },
  "capabilities": [{ "kind": "workspace:read" }, { "kind": "agent:read" }, { "kind": "workspace:write" }, { "kind": "settings:own" }]
}
